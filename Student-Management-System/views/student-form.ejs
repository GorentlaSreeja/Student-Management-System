<%- include('partials/header') %>
<div class="app-shell"><%- include('partials/sidebar', { userName: userName }) %><main class="main-content"><header class="topbar"><div><div class="eyebrow">STUDENT DIRECTORY</div><h1><%= title %></h1></div><a class="btn secondary" href="/dashboard">← Back to dashboard</a></header><section class="form-card"><div class="form-card-heading"><div class="form-icon">＋</div><div><h2>Student information</h2><p>Enter the details below. Fields marked * are required.</p></div></div><% if (error) { %><div class="alert error"><%= error %></div><% } %><form method="POST" action="<%= formAction %>" class="student-form"><div class="field-grid"><label>Student ID *<input name="studentId" required maxlength="30" value="<%= student.studentId || '' %>" placeholder="e.g. STU-2026-001"></label><label>Full name *<input name="fullName" required maxlength="100" value="<%= student.fullName || '' %>" placeholder="Student full name"></label><label>Email address *<input type="email" name="email" required value="<%= student.email || '' %>" placeholder="student@example.com"></label><label>Department *<select name="department" required><option value="">Select department</option><% ['Computer Science','Information Technology','AI & Machine Learning','Electronics','Mechanical','Civil','Business Administration','Other'].forEach(d => { %><option value="<%= d %>" <%= student.department === d ? 'selected' : '' %>><%= d %></option><% }) %></select></label><label>Academic year *<select name="year" required><option value="">Select year</option><% ['1st Year','2nd Year','3rd Year','4th Year'].forEach(y => { %><option value="<%= y %>" <%= student.year === y ? 'selected' : '' %>><%= y %></option><% }) %></select></label><label>Phone number<input name="phone" type="tel" maxlength="20" value="<%= student.phone || '' %>" placeholder="Optional"></label><label>Status<select name="status"><option <%= !student.status || student.status === 'Active' ? 'selected' : '' %>>Active</option><option <%= student.status === 'Inactive' ? 'selected' : '' %>>Inactive</option></select></label></div><div class="form-actions"><a class="btn secondary" href="/dashboard">Cancel</a><button class="btn primary" type="submit"><%= student._id ? 'Save changes' : 'Add student' %> <span>→</span></button></div></form></section></main></div></body></html>
