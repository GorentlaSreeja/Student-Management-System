<%- include('partials/header') %>
<div class="app-shell"><%- include('partials/sidebar', { userName: userName }) %><main class="main-content">
<header class="topbar"><div><div class="eyebrow">STUDENT PROFILE</div><h1>Student details</h1></div><div class="top-actions"><a class="btn secondary" href="/dashboard">← Back to directory</a><a class="btn primary" href="/students/<%= student._id %>/edit">Edit student</a></div></header>
<section class="detail-card"><div class="detail-hero"><div class="detail-avatar"><%= student.fullName.charAt(0).toUpperCase() %></div><div><h2><%= student.fullName %></h2><p><%= student.email %></p><span class="status <%= student.status.toLowerCase() %>"><%= student.status %></span></div></div>
<div class="detail-grid"><div><small>STUDENT ID</small><strong><%= student.studentId %></strong></div><div><small>DEPARTMENT</small><strong><%= student.department %></strong></div><div><small>ACADEMIC YEAR</small><strong><%= student.year %></strong></div><div><small>PHONE</small><strong><%= student.phone || 'Not provided' %></strong></div><div><small>RECORD CREATED</small><strong><%= new Date(student.createdAt).toLocaleDateString('en-IN') %></strong></div><div><small>LAST UPDATED</small><strong><%= new Date(student.updatedAt).toLocaleDateString('en-IN') %></strong></div></div></section>
<footer class="page-footer">CampusFlow <span>·</span> Student records, made simpler.</footer></main></div><script src="/js/app.js"></script></body></html>
