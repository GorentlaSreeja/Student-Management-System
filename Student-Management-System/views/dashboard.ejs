<%- include('partials/header') %>
<div class="app-shell"><%- include('partials/sidebar', { userName: userName }) %><main class="main-content"><header class="topbar"><div><div class="eyebrow">CAMPUS OVERVIEW</div><h1>Dashboard</h1></div><div class="top-actions"><a class="btn secondary" href="/attendance">✓ Mark attendance</a><a class="btn primary" href="/students/new">＋ Add student</a></div></header>
<% if (success) { %><div class="alert success"><%= success %></div><% } %>
<section class="welcome-row"><div><h2>Good to see you, <%= userName %> <span>✦</span></h2><p>Here’s what’s happening with your students today.</p></div><div class="date-chip"><span>◷</span> <%= new Date().toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' }) %></div></section>
<section class="stats-grid"><article class="stat-card"><div class="stat-top"><span>Total students</span><span class="stat-icon purple">▤</span></div><div class="stat-value"><%= stats.total %></div><div class="stat-note">Across all departments</div></article><article class="stat-card"><div class="stat-top"><span>Active students</span><span class="stat-icon green">✓</span></div><div class="stat-value"><%= stats.active %></div><div class="stat-note">Currently enrolled</div></article><article class="stat-card"><div class="stat-top"><span>Inactive students</span><span class="stat-icon amber">Ⅱ</span></div><div class="stat-value"><%= stats.inactive %></div><div class="stat-note">Not currently active</div></article></section>
<section class="table-card"><div class="table-heading"><div><h3>Student directory</h3><p>Manage and review your student records.</p></div><form class="search-form" method="GET" action="/dashboard"><span>⌕</span><input type="search" name="q" value="<%= q %>" placeholder="Search students..."><button type="submit">Search</button></form></div>
<% if (students.length) { %><div class="table-wrap"><table><thead><tr><th>STUDENT</th><th>STUDENT ID</th><th>DEPARTMENT</th><th>YEAR</th><th>STATUS</th><th class="right">ACTIONS</th></tr></thead><tbody>
<% students.forEach(student => { %><tr><td><div class="student-cell"><div class="student-avatar"><%= student.fullName.charAt(0).toUpperCase() %></div><div><strong><%= student.fullName %></strong><small><%= student.email %></small></div></div></td><td class="id-text"><%= student.studentId %></td><td><%= student.department %></td><td><%= student.year %></td><td><span class="status <%= student.status.toLowerCase() %>"><%= student.status %></span></td><td class="right actions"><a href="/students/<%= student._id %>" aria-label="View <%= student.fullName %>">View</a><a href="/students/<%= student._id %>/edit" aria-label="Edit <%= student.fullName %>">Edit</a><form method="POST" action="/students/<%= student._id %>?_method=DELETE" onsubmit="return confirm('Delete this student record?')"><button type="submit" class="delete-action">Delete</button></form></td></tr><% }) %>
</tbody></table></div><% } else { %><div class="empty-state"><div class="empty-icon">▤</div><h3><%= q ? 'No matching students' : 'No students yet' %></h3><p><%= q ? 'Try another name, ID, email or department.' : 'Add your first student to start building your directory.' %></p><% if (!q) { %><a class="btn primary" href="/students/new">＋ Add your first student</a><% } %></div><% } %>
<div class="table-foot"><span>Showing <strong><%= students.length %></strong> of <strong><%= matching %></strong> matching record(s)</span><span>Latest records first</span></div>
<% if (totalPages > 1) { %><nav class="pagination" aria-label="Student pages">
<% if (page > 1) { %><a href="/dashboard?page=<%= page - 1 %>&q=<%= encodeURIComponent(q) %>">← Previous</a><% } else { %><span class="disabled">← Previous</span><% } %>
<span>Page <strong><%= page %></strong> of <strong><%= totalPages %></strong></span>
<% if (page < totalPages) { %><a href="/dashboard?page=<%= page + 1 %>&q=<%= encodeURIComponent(q) %>">Next →</a><% } else { %><span class="disabled">Next →</span><% } %>
</nav><% } %></section><footer class="page-footer">CampusFlow <span>·</span> Student records, made simpler.</footer></main></div>
<script src="/js/app.js"></script></body></html>
