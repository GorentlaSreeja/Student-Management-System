<%- include('partials/header') %>
<main class="auth-shell"><section class="auth-panel"><a class="brand auth-brand" href="/"><span class="brand-mark">C</span><span>Campus<span class="brand-light">Flow</span></span></a><div class="auth-content"><div class="eyebrow">STUDENT MANAGEMENT, SIMPLIFIED</div><h1>Welcome<br>back<span class="accent">.</span></h1><p class="muted">Sign in to manage your students and keep your campus organised.</p>
